# Add this block to /srv/caddy/Caddyfile on rio-server, then reload Caddy:
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# (/srv is mounted at the same path inside the caddy container.)

e1-pixel-pit.rrriooo.com {
	root * /srv/e1-pixel-pit
	encode zstd gzip

	# Vite fingerprints everything in /assets: cache it for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# index.html must always be fresh so a deploy shows up straight away.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
